# ── MLflow / DagsHub ────────────────────────────────────────────────────────
# Remplace USERNAME et REPO_NAME par ton nom d'utilisateur et le nom du dépôt
MLFLOW_TRACKING_URI=https://dagshub.com/USERNAME/REPO_NAME.mlflow
DAGSHUB_USERNAME=ton_username
DAGSHUB_TOKEN=ton_token_dagshub

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Obtiens ta clé sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ta_cle_gemini

# ── Modèle MLflow ────────────────────────────────────────────────────────────
# Nom du modèle enregistré dans le Model Registry de MLflow/DagsHub
MODEL_NAME=RestaurantRevenueModel
# Étape du modèle : None | Staging | Production | Archived
MODEL_STAGE=Production
